# Release settings for a local `make release`. Copy to .env, which git
# ignores, and fill it in. The names and values are the same as the repository
# secrets the release workflow uses. Shell syntax: quote a value that holds
# spaces or symbols with single quotes.

# Developer ID Application certificate with its private key, exported from
# Keychain Access as .p12: base64 -i DeveloperID.p12 | tr -d '\n'
DEVELOPER_ID_P12_BASE64=
DEVELOPER_ID_P12_PASSWORD=''

# Developer ID provisioning profiles: base64 -i <file> | tr -d '\n'
# MacDNS_Developer_ID.provisionprofile
APP_PROFILE_BASE64=
# MacDNS_Extension_Developer_ID.provisionprofile
EXTENSION_PROFILE_BASE64=
# MacDNS_Content_Filter_Developer_ID.provisionprofile
CONTENT_FILTER_PROFILE_BASE64=

# App Store Connect API key for notarytool (Users and Access > Integrations).
# The key file: base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
NOTARY_KEY_P8_BASE64=
NOTARY_KEY_ID=
NOTARY_ISSUER_ID=

# Sparkle EdDSA private key, the contents of the file from
# .build/artifacts/sparkle/Sparkle/bin/generate_keys -x <file>
SPARKLE_PRIVATE_KEY=

# Keygen token that creates trial licenses.
KEYGEN_TRIAL_TOKEN=

# Optional. Writes highlights into Scripts/release-notes.sh output.
ANTHROPIC_API_KEY=